---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PostCarousel from "../components/PostCarousel.astro";
import ColorScript from "../components/ColorScript.astro";
import Tags from "../components/Tags.astro";
import { title, subtitle } from "../settings/settings.json"
import { Content as About } from "./about.md";
import getTags from "../scripts/getTags";

const posts = await getCollection("posts");
const tags = getTags(posts);
---

<!doctype html>
<html lang="en-us">
	<BaseHead title={title} description={subtitle} />
	<body>
		<Header title={title} />
		<main>
			<h2>Hello!</h2>
			<About />

			<br />

			<h2>Latest on the bloggity blog</h2>

			<PostCarousel allPosts={posts} />

			<p class="center">
				You can also <a href="https://blahg.netlify.app/rss.xml">
					subscribe with RSS!
				</a>
			</p>
			<br />

			<Tags tags={tags} all />
		</main>
		<Footer />
		<ColorScript />
	</body>
</html>

<style>
	h2 {
		border-bottom: 2px solid var(--gray);
		padding-bottom: 0.5rem;
	}
	:global(.about-card) {
		font-size: clamp(1rem, 0.6rem + 2vw, 1.3rem);
	}
</style>
