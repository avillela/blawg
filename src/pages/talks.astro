---

<!doctype html>
<html lang="en-us">
	<BaseHead title={`Talks - ${title}`} description={subtitle} />
	<body>
		<Header />
		<main>
			<content>
				<p class="description">A collection of my talks, webinars, and podcast appearances</p>

				{talks.map((yearGroup) => (
					<div class="year-section" id={`year-${yearGroup.year}`}>
						<h2><a href={`#year-${yearGroup.year}`}>{yearGroup.year}</a></h2>
						<ul class="talks-list">
							{yearGroup.videos.map((talk) => (
								<li>
									<a href={talk.url} target="_blank" rel="noopener noreferrer">
										{talk.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				))}
			</content>
		</main>
		<Footer />
		<ColorScript />
	</body>
</html>

<style>
	.description {
		text-align: center;
		margin-bottom: 2rem;
	}

	.year-section {
		margin-bottom: 3rem;
	}

	.year-section h2 {
		font-size: 1.8rem;
		margin-bottom: 1rem;
		border-bottom: 2px solid var(--color-border);
		padding-bottom: 0.5rem;
	}

	.year-section h2 a {
		text-decoration: none;
	}

	.year-section h2 a:hover {
		text-decoration: underline;
	}

	.talks-list {
		list-style: none;
		padding-left: 0;
	}

	.talks-list li {
		margin-bottom: 0.75rem;
		padding-left: 1.5rem;
		position: relative;
	}

	.talks-list li::before {
		content: "■";
		color: #f5b3d4;
		position: absolute;
		left: 0;
	}

	.talks-list a {
		color: var(--color-text);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.talks-list a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}
</style>
