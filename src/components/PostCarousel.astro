---
const { allPosts } = Astro.props;

const posts = allPosts
	.sort(
		(a, b) =>
			new Date(b.data.updated || b.data.added).valueOf() -
			new Date(a.data.updated || a.data.added).valueOf(),
	)
	.slice(0, 10)
	.map((post) => {
		const imgMatch = post.body?.match(/!\[.*?\]\(([^)\s"]+)/);
		return {
			slug: post.data.slug,
			title: post.data.title,
			description: post.data.description,
			added: post.data.added,
			heroImage: imgMatch?.[1] ?? null,
		};
	});

function formatDate(dateStr) {
	return new Date(dateStr).toLocaleDateString("en-us", {
		year: "2-digit",
		month: "short",
		day: "numeric",
	});
}
---

<div class="carousel-outer">
	<button class="carousel-arrow" id="carousel-prev" aria-label="Previous posts">&#8249;</button>
	<div class="carousel-track" id="carousel-track">
		{
			posts.map((post) => (
				<a href={`/post/${post.slug}/`} class="tile">
					<div class="tile-img-wrap">
						{post.heroImage ? (
							<img src={post.heroImage} alt={post.title} loading="lazy" />
						) : (
							<div class="tile-img-placeholder" />
						)}
						<span class="tile-date">{formatDate(post.added)}</span>
					</div>
					<div class="tile-info">
						<strong>{post.title}</strong>
						<p>{post.description}</p>
					</div>
				</a>
			))
		}
	</div>
	<button class="carousel-arrow" id="carousel-next" aria-label="Next posts">&#8250;</button>
</div>

<script>
	const track = document.getElementById("carousel-track") as HTMLElement;
	const prev = document.getElementById("carousel-prev") as HTMLButtonElement;
	const next = document.getElementById("carousel-next") as HTMLButtonElement;

	function scrollCarousel(dir: number) {
		const tile = track.querySelector<HTMLElement>(".tile");
		if (!tile) return;
		const gap = parseFloat(getComputedStyle(track).gap) || 0;
		track.scrollBy({ left: dir * (tile.offsetWidth + gap), behavior: "smooth" });
	}

	prev.addEventListener("click", () => scrollCarousel(-1));
	next.addEventListener("click", () => scrollCarousel(1));
</script>

<style>
	.carousel-outer {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
	}

	.carousel-track {
		display: flex;
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		flex: 1;
	}

	.carousel-track::-webkit-scrollbar {
		display: none;
	}

	.tile {
		scroll-snap-align: start;
		flex: 0 0 calc(33.333% - 0.667rem);
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		background: #e6f4ff;
		border: 2px solid var(--gray);
		border-radius: 10px;
		overflow: hidden;
	}

	.tile-img-wrap {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #cce0f0;
	}

	.tile-img-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.tile-img-placeholder {
		width: 100%;
		height: 100%;
		background: #cce0f0;
	}

	.tile-date {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		background: rgba(0, 0, 0, 0.75);
		color: #fff;
		font-size: 0.75rem;
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		white-space: nowrap;
	}

	.tile-info {
		padding: 0.6rem 0.75rem 0.75rem;
	}

	.tile-info strong {
		display: block;
		font-size: 0.95rem;
		line-height: 1.3;
		margin-bottom: 0.3rem;
		color: #1a1a1a;
		background: transparent;
	}

	.tile-info p {
		margin: 0;
		font-size: 0.82rem;
		color: #555;
		line-height: 1.4;
	}

	.carousel-arrow {
		all: unset;
		background: rgba(0, 0, 0, 0.5);
		color: var(--white);
		border-radius: 50%;
		width: 2rem;
		height: 2rem;
		font-size: 1.5rem;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		transition: background 0.2s;
		line-height: 1;
	}

	.carousel-arrow:hover {
		background: rgba(0, 0, 0, 0.85);
	}

	@media (max-width: 600px) {
		.tile {
			flex: 0 0 100%;
		}
	}

	@media (min-width: 601px) and (max-width: 850px) {
		.tile {
			flex: 0 0 calc(50% - 0.5rem);
		}
	}
</style>
