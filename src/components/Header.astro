---
import { Image } from "astro:assets";
import HeaderLink from "./HeaderLink.astro";
import { title, subtitle } from "../settings/settings.json"
import profilePhoto from "../assets/adriana-capybara.jpg";

---

<header>
	<div class="header-section">
		<div class="header-frame">
			<div class="name-row">
				<Image
					src={profilePhoto}
					alt={title}
					width={100}
					height={100}
					class="avatar"
				/>
				<h1>{title}</h1>
			</div>
			<h2>{subtitle}</h2>
		</div>
	</div>
</header>
<nav>
	<HeaderLink href="/">home</HeaderLink>
	<HeaderLink href="/posts">posts</HeaderLink>
	<HeaderLink href="/talks">talks</HeaderLink>
	<HeaderLink href="/socials">connect</HeaderLink>
	<HeaderLink href="https://bio.site/geekingout" target="_blank" rel="noopener noreferrer">podcast</HeaderLink>
</nav>
<style>
	.name-row {
		display: flex;
		align-items: center;
		gap: 0.75em;
	}
	.avatar {
		border-radius: 50%;
		object-fit: cover;
		width: 100px;
		height: 100px;
	}
	h2 {
		margin: 0.5em 0;
	}
</style>
